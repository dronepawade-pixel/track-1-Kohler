# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (never NEXT_PUBLIC_): powers POST /api/recommend.
# Free key: https://aistudio.google.com/apikey (no credit card, Flash models).
GEMINI_API_KEY=
# Optional override; must be a free-tier Flash model.
GEMINI_MODEL=gemini-2.0-flash
